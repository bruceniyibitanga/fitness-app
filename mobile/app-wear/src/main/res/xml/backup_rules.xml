<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules for Android 11 and earlier. Android 12 and later use
  data_extraction_rules.xml instead; that file explains why nothing is
  backed up. allowBackup="false" already turns backup off, and these rules
  keep it off if that flag is ever changed by mistake.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
