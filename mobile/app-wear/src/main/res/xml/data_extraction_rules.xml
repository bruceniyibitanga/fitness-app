<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer rules for Android 12 and later.

  Nothing is backed up or transferred. The app stores health data (training
  history, bodyweight, pain notes), and that data is encrypted with a key kept
  in the Android Keystore. Keystore keys never leave the device, so a copy of
  the data would be unreadable on another device anyway.

  People move their data with the password-protected export instead. See
  docs/app/adr/0002-local-first-encrypted-storage.md.

  allowBackup="false" in the manifest turns off cloud backup. These rules
  also turn off device-to-device transfer, which allowBackup alone does not
  cover from Android 12.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
