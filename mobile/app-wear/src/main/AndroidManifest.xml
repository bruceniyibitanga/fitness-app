<?xml version="1.0" encoding="utf-8"?>
<!--
  Watch app manifest.

  No permissions are requested yet. Heart rate and exercise permissions are
  added with the Health Services workout that uses them.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <application
        android:name=".LevitxWearApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Levitx">

        <!--
          Not standalone, in Google Play's sense: the goal is chosen in the
          phone app and copied to the watch, so the watch app needs the phone
          app installed. Once it has a goal, the watch runs whole sessions with
          the phone out of reach and syncs them later. Flip this to true if
          the watch ever gets its own goal picker.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <!--
          An empty task affinity keeps the app's entry in the watch's recents
          list working correctly, as the Wear OS docs recommend.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives the goal, bests and bands from the phone, and the phone's
          confirmations that sessions arrived, over the Wearable Data Layer.
          The paths must match SyncPaths in :sync.

          It has to be exported for Google Play services to reach it. That is
          safe: WearableListenerService only accepts calls from Google Play
          services, and Play services only delivers data written by a copy of
          this app with the same package name and signing key.
        -->
        <service
            android:name=".sync.PhoneDataListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/levitx/state" />
                <data android:pathPrefix="/levitx/acks/" />
            </intent-filter>
        </service>
    </application>
</manifest>
