    <string name="how_bodyweight_invalid">Enter a weight between 20 and 350 kg, or leave it empty.</string>
    <string name="week_title">When will you train?</string>
    <string name="week_body">We\'ll remind you on these days. Miss one and your plan just moves to the next session. Nothing breaks.</string>
