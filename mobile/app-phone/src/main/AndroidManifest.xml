<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone app manifest.

  No permissions are requested yet. Each one is added only when a feature
  needs it, with a comment saying which feature (see docs/app/SECURITY.md).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".LevitxPhoneApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Levitx">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Receives finished workouts from the watch over the Wearable Data
          Layer. The paths must match SyncPaths in :sync. The sessions path
          is for watches still on an older version of the app.

          It has to be exported for Google Play services to reach it. That is
          safe: WearableListenerService only accepts calls from Google Play
          services, and Play services only delivers data written by a copy of
          this app with the same package name and signing key.
        -->
        <service
            android:name=".sync.WatchDataListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" />
                <data android:host="*" />
                <data android:pathPrefix="/levitx/workouts/" />
                <data android:pathPrefix="/levitx/sessions/" />
            </intent-filter>
        </service>
    </application>
</manifest>
