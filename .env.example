# Public site URL, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Waitlist storage. All server-only: never prefix these with NEXT_PUBLIC_.
# Leave them empty locally and signups are logged to the terminal (masked) instead.

# Kit (kit.com), free up to 10,000 subscribers. Settings > Developer > API key (v4).
KIT_API_KEY=
# Optional: numeric ID of a tag like "lever-waitlist" (it's in the tag's URL in Kit).
KIT_TAG_ID=

# Later, if you move to a database instead of Kit.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
