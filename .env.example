# Public site URL, used for canonical links, the sitemap and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Waitlist storage. All server-only: never prefix these with NEXT_PUBLIC_.
# Leave them empty locally and signups are logged to the terminal (masked) instead.

# Plunk (useplunk.com). Settings > API Keys > the SECRET key (starts with sk_).
# Not the public pk_ key: the contacts endpoint rejects it.
PLUNK_SECRET_KEY=

# Later, if you move to a database instead of Plunk.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
